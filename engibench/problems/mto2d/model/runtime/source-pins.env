# Source-build inputs. This file is consumed by build_source_image.sh.
#
# Git inputs are pinned by full commit. The base image is pinned to the
# linux/amd64 manifest, not the mutable ubuntu:20.04 tag.
BASE_IMAGE_NAME='docker.io/library/ubuntu:20.04'
BASE_IMAGE_DIGEST='sha256:c664f8f86ed5a386b0a340d981b8f81714e21a8b9c73f658c4bea56aa179d54a'
BASE_IMAGE="ubuntu:20.04@${BASE_IMAGE_DIGEST}"
# Canonical archive state used for every build/runtime package. Ubuntu 20.04
# supports this service with the apt 2.0.10 carried by the pinned base image.
APT_SNAPSHOT='20260728T000000Z'
CA_CERTIFICATES_VERSION='20240203~20.04.1'
LIBSSL1_1_VERSION='1.1.1f-1ubuntu2.24'
OPENSSL_VERSION='1.1.1f-1ubuntu2.24'
OPENSSH_CLIENT_VERSION='1:8.2p1-4ubuntu0.13'

# Approved SPDX expression for the distributable solver image. The publisher
# exact-compares the image label to this versioned pin.
APPROVED_IMAGE_LICENSES='GPL-3.0-or-later'

OPENFOAM_REPOSITORY='https://github.com/OpenFOAM/OpenFOAM-5.x.git'
OPENFOAM_COMMIT='7f7d351b741bf6406366a043cac98de56d2d44dd'

THIRD_PARTY_REPOSITORY='https://github.com/OpenFOAM/ThirdParty-5.x.git'
THIRD_PARTY_COMMIT='a807587a7babd4d03b62794b26e5ef4105301416'

# The legacy SIF carries upstream Scotch 6.0.8 under OpenFOAM's expected
# scotch_6.0.3 directory name. Pin and verify that exact source rather than
# enabling OpenMPI's removed MPI-1 compatibility surface globally.
SCOTCH_REPOSITORY='https://gitlab.inria.fr/scotch/scotch.git'
SCOTCH_COMMIT='6ac391912e21820e71748153d0f4e5107e628352'
SCOTCH_MAKEFILE_SHA256='cee969a6e53b919416f809d8a453f6ce60b972af3e9ac3fced9603224e68153b'
SCOTCH_DGRAPH_HALO_SHA256='fd73ba70d938c9ecbfa3a6fc008962ed253ee9de65919a3fb9a5255aff2be131'

OPENMPI_VERSION='4.0.4'
OPENMPI_ARCHIVE_URL='https://download.open-mpi.org/release/open-mpi/v4.0/openmpi-4.0.4.tar.gz'
OPENMPI_ARCHIVE_SHA256='dca264f420411f540a496bdd131bffd83e325fc9006286b39dd19b62d7368233'

PETSC_REPOSITORY='https://gitlab.com/petsc/petsc.git'
PETSC_COMMIT='30e86313c4ca9b4414d2a7d1611388a22af15427'

SWAK4FOAM_REPOSITORY='https://github.com/Unofficial-Extend-Project-Mirror/openfoam-extend-swak4Foam-dev.git'
SWAK4FOAM_COMMIT='9d8f12af95f5b6496ce28849d013b729a6a73abf'

# Exact retained warm-ready case archive. Change this only after reviewing and
# versioning a deliberate solver/case update.
MTO2D_CASE_ARCHIVE_SHA256='f90546a3f647aec6e6f0cac7a38ca580c32e0b9b15ed5b459e865551cdcf1fb0'

# The modified MMA implementation remains recoverable at this MTO-Scripts
# commit and is included in the approved source build.
MMA_SOURCE_COMMIT='3b6966c02d9aadc8a1f8d16632c4c0af27008ea4'
MMA_IMPLEMENTATION_PATH='cold_start/2D/my_MMA/MMA.c'
MMA_HEADER_PATH='cold_start/2D/my_MMA/MMA.h'
